# Copy to .env and fill in real values. Never commit .env.
# Only the values relevant to the final data source choice (see
# DATA_SOURCES.md) will actually be needed.

# --- Dune Analytics (if chosen) ---
DUNE_API_KEY=

# --- Direct RPC (if chosen) ---
INFURA_API_KEY=
ALCHEMY_API_KEY=

# --- Price feed cross-referencing ---
COINGECKO_API_KEY=

# --- Groq risk advisories (local publish job only) ---
GROQ_API_KEY=
# The same key must ALSO be set as a secret env var on the Render service for the
# assistant (backend/assistant). Optional Render overrides: ASSISTANT_MODEL
# (default openai/gpt-oss-20b), ASSISTANT_PER_IP_PER_MIN (3), ASSISTANT_GLOBAL_PER_MIN (3),
# ASSISTANT_DAILY_CAP (200). See docs/SETUP.md "Grounded assistant".

# --- MongoDB ---
MONGODB_URI=

# --- Supabase (live dashboard backend — write side, used only by
# ingestion/push_to_supabase.py, NEVER by the Render backend or Vercel
# frontend). See SETUP.md's "Live backend (Supabase + Render)" section. ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
